{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "type-battle-server",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "BattleRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BattleRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://plailystudio.github.io,http://localhost:5173,http://127.0.0.1:5173"
  },
  "observability": { "enabled": false }
}
